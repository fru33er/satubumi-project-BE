# Application Configuration
APP_NAME="Satubumi API Engine"
APP_ENV="development"
DEBUG=True
PORT=8000

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","https://satubumi.org"]

# Database Configuration (PostgreSQL + PostGIS)
POSTGRES_USER=satubumi
POSTGRES_PASSWORD=satubumipassword
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=satubumi_db
DATABASE_URL=postgresql+psycopg2://satubumi:satubumipassword@localhost:5432/satubumi_db

# Security & JWT Configuration
SECRET_KEY="supersecretjwtkeyforbackendauthenticationchangeinproduction"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redis Cache Configuration
REDIS_URL="redis://localhost:6379/0"

# Google Earth Engine (GEE) Credentials
GEE_PROJECT_ID=""
GEE_SERVICE_ACCOUNT_EMAIL=""
GEE_PRIVATE_KEY_FILE_PATH=""
USE_MOCK_GEE=True
